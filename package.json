{
  "name": "club-league",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/react": "^18.2.21",
    "@types/react-native": "^0.72.2",
    "railway": "^3.16.0",
    "turbo": "^1.4.2",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "clean": "turbo run clean && rm -rf yarn.lock",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "echo \"No tests yet\""
  },
  "resolutions": {
    "@types/node": "^24.19.2",
    "metro": "~0.76.7",
    "metro-resolver": "~0.76.7"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "packageManager": "yarn@3.4.1"
}
