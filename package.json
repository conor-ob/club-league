{
  "name": "club-league",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/react": "^18.3.31",
    "railway": "^3.17.0",
    "turbo": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "clean": "turbo run clean && rm -rf yarn.lock",
    "build": "turbo run build",
